# Go
bin/
dist/
*.test
*.prof
*.coverprofile
profile.cov

# Coverage output, named rather than globbed. `coverage.*` was here, and it
# also matches coverage.go -- which is source, and which git then hid from
# every `git status` and every `git add -A` until CI cloned the repository
# without it. An ignore pattern broad enough to swallow source is a pattern
# that fails silently and locally never notices.
/coverage.out
/coverage.html
/coverage.txt

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temp/logs
*.log
*.out
logs/
tmp/
runtime/
temp/

# Python legacy
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Intermediate frames for the documentation's animations. The GIFs they are
# folded into are committed; the several hundred PNGs behind each one are not.
docs/media/.frames/

# Docker future
*.tar

# Environment
.env

# Go workspace is not used for the active monorepo baseline.
go.work
go.work.sum
